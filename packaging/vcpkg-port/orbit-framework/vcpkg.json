{
  "name": "orbit-framework",
  "version": "1.4.0",
  "description": "A blazing fast, asynchronous, and middleware-driven C++20 HTTP/3 web framework",
  "homepage": "https://github.com/varuns2903/orbit-framework",
  "license": "MIT",
  "supports": "!uwp",
  "dependencies": [
    "openssl",
    "zlib",
    "libpq",
    "curl",
    "libmariadb",
    "mongo-c-driver",
    "nghttp2",
    "nghttp3",
    {
      "name": "ngtcp2",
      "features": ["openssl"]
    },
    "hiredis",
    "pkgconf",
    {
      "name": "liburing",
      "platform": "linux"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "grpc": {
      "description": "gRPC support",
      "dependencies": ["grpc"]
    }
  }
}
