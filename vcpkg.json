{
  "name": "orbit-framework",
  "version-string": "1.5.1",
  "description": "A blazing fast, asynchronous, and middleware-driven C++20 HTTP/3 web framework",
  "builtin-baseline": "a1cae005c39be7b18ba319fced856b68d7276271",
  "dependencies": [
    "openssl",
    "zlib",
    {
      "name": "curl",
      "features": [
        "http2"
      ]
    },
    "nghttp2",
    "pkgconf",
    {
      "name": "liburing",
      "platform": "linux"
    }
  ],
  "features": {
    "postgres": {
      "description": "PostgreSQL client (ORBIT_ENABLE_POSTGRES)",
      "dependencies": [
        "libpq"
      ]
    },
    "mariadb": {
      "description": "MySQL/MariaDB client (ORBIT_ENABLE_MARIADB)",
      "dependencies": [
        "libmariadb"
      ]
    },
    "mongodb": {
      "description": "MongoDB client (ORBIT_ENABLE_MONGODB)",
      "dependencies": [
        "mongo-c-driver"
      ]
    },
    "http3": {
      "description": "HTTP/3 and QUIC (ORBIT_ENABLE_HTTP3)",
      "dependencies": [
        "nghttp3",
        {
          "name": "ngtcp2",
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "grpc": {
      "description": "gRPC support",
      "dependencies": [
        "grpc"
      ]
    }
  },
  "default-features": [
    "postgres",
    "mariadb",
    "mongodb",
    "http3"
  ]
}
