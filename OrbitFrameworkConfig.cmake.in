@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Record which subsystems this build of Orbit was actually compiled with, so a
# consumer is not asked for dependencies that were switched off at build time.
set(ORBIT_ENABLE_HTTP3 @ORBIT_ENABLE_HTTP3@)
set(ORBIT_ENABLE_REDIS @ORBIT_ENABLE_REDIS@)
set(ORBIT_ENABLE_POSTGRES @ORBIT_ENABLE_POSTGRES@)
set(ORBIT_ENABLE_MARIADB @ORBIT_ENABLE_MARIADB@)
set(ORBIT_ENABLE_MONGODB @ORBIT_ENABLE_MONGODB@)

find_dependency(OpenSSL)
find_dependency(ZLIB)
find_dependency(CURL)
find_package(PkgConfig REQUIRED)

if(ORBIT_ENABLE_POSTGRES)
    find_dependency(PostgreSQL)
endif()

# The database drivers are located exactly the way the top-level CMakeLists
# locates them: prefer a CONFIG package (what vcpkg installs), and fall back to
# pkg-config for system packages. The previous version of this file demanded
# the CONFIG packages unconditionally, so find_package(OrbitFramework REQUIRED)
# failed on any machine where these came from the system rather than vcpkg.
if(ORBIT_ENABLE_MARIADB)
    find_package(unofficial-libmariadb CONFIG QUIET)
    if(NOT unofficial-libmariadb_FOUND)
        pkg_search_module(MARIADB REQUIRED libmariadb mariadb)
    endif()
endif()

if(ORBIT_ENABLE_MONGODB)
    find_package(mongoc-1.0 CONFIG QUIET)
    if(NOT mongoc-1.0_FOUND)
        find_package(mongoc CONFIG QUIET)
    endif()
    if(NOT mongoc-1.0_FOUND AND NOT mongoc_FOUND)
        pkg_search_module(MONGOC REQUIRED libmongoc-1.0 mongoc-1.0 mongoc2)
    endif()
endif()

if(ORBIT_ENABLE_REDIS)
    find_package(hiredis CONFIG QUIET)
    if(NOT hiredis_FOUND)
        pkg_search_module(HIREDIS REQUIRED hiredis)
    endif()
endif()

# Imported targets referenced by the exported link interface must be recreated
# here, or the consumer's link line refers to targets that do not exist.
pkg_check_modules(NGHTTP2 REQUIRED IMPORTED_TARGET libnghttp2)

if(ORBIT_ENABLE_HTTP3)
    pkg_check_modules(NGTCP2 REQUIRED IMPORTED_TARGET libngtcp2)
    pkg_search_module(NGTCP2_CRYPTO REQUIRED IMPORTED_TARGET
        libngtcp2_crypto_openssl libngtcp2_crypto_ossl libngtcp2_crypto_quictls)
    pkg_check_modules(NGHTTP3 REQUIRED IMPORTED_TARGET libnghttp3)
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    pkg_check_modules(URING REQUIRED IMPORTED_TARGET liburing)
endif()

# Include the generated targets file
include("${CMAKE_CURRENT_LIST_DIR}/OrbitFrameworkTargets.cmake")

# Compatibility spelling: earlier README examples linked OrbitFramework::server_core.
if(TARGET OrbitFramework::core AND NOT TARGET OrbitFramework::server_core)
    add_library(OrbitFramework::server_core INTERFACE IMPORTED)
    target_link_libraries(OrbitFramework::server_core INTERFACE OrbitFramework::core)
endif()

check_required_components(OrbitFramework)
