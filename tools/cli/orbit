#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import shutil

# The vcpkg manifest a new project needs: Orbit's dependencies, including
# those of its default features, at the same builtin-baseline. Kept equal to
# the repository's vcpkg.json by tools/cli/check_manifest.py (run in CI).
ORBIT_BUILTIN_BASELINE = "a1cae005c39be7b18ba319fced856b68d7276271"
ORBIT_DEPENDENCIES = [
    "brotli",
    {"name": "curl", "features": ["http2"]},
    "libmariadb",
    "libpq",
    {"name": "liburing", "platform": "linux"},
    "llhttp",
    "mongo-c-driver",
    "nghttp2",
    "openssl",
    "pkgconf",
    "zlib",
    "zstd",
]


def project_manifest(project_name):
    return {
        "name": project_name.lower().replace("_", "-"),
        "version": "0.1.0",
        "builtin-baseline": ORBIT_BUILTIN_BASELINE,
        "dependencies": ORBIT_DEPENDENCIES,
    }


def default_jobs():
    """Parallel compile jobs: one per CPU, but at most one per 2 GB of RAM.

    Orbit's translation units (nlohmann/json, inja, coroutines) take up to
    ~1.5 GB each in Debug builds, so one job per CPU can exhaust memory.
    """
    cpus = os.cpu_count() or 2
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_gb = int(line.split()[1]) / (1024 * 1024)
                    return max(1, min(cpus, int(mem_gb // 2)))
    except OSError:
        pass
    return max(1, min(cpus, 4))

def run_command(cmd, cwd=None):
    print(f"🚀 Running: {' '.join(cmd)}")
    result = subprocess.run(cmd, cwd=cwd)
    if result.returncode != 0:
        print(f"❌ Error executing command: {' '.join(cmd)}")
        sys.exit(result.returncode)

def create_project(project_name, use_fetch):
    if os.path.exists(project_name):
        print(f"❌ Directory '{project_name}' already exists.")
        sys.exit(1)
        
    os.makedirs(project_name)
    
    # 1. main.cpp
    main_cpp = """#include <orbit/server/App.hpp>
#include <orbit/config/Config.hpp>
#include <orbit/http/json.hpp>
#include <iostream>

int main() {
    orbit::config::ServerConfig config;
    config.port = 3000;

    orbit::server::App app(config);

    app.get("/", []() -> std::string {
        return "Hello from Orbit Framework!";
    });

    app.get("/api/status", []() -> nlohmann::json {
        return {{"status", "ok"}};
    });

    std::cout << "🚀 Orbit Server is running on http://localhost:3000" << std::endl;
    app.listen();

    return 0;
}
"""
    with open(os.path.join(project_name, "main.cpp"), "w") as f:
        f.write(main_cpp)

    # 2. CMakeLists.txt
    cmake_lists = f"""cmake_minimum_required(VERSION 3.20)
project({project_name} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

"""
    if use_fetch:
        cmake_lists += """include(FetchContent)
FetchContent_Declare(
  OrbitFramework
  GIT_REPOSITORY https://github.com/varuns2903/orbit-framework.git
  GIT_TAG        v2.0.0
)
FetchContent_MakeAvailable(OrbitFramework)
"""
    else:
        cmake_lists += """find_package(OrbitFramework REQUIRED)
"""

    cmake_lists += f"""
add_executable({project_name} main.cpp)
target_link_libraries({project_name} PRIVATE OrbitFramework::core)
"""
    with open(os.path.join(project_name, "CMakeLists.txt"), "w") as f:
        f.write(cmake_lists)

    # 3. vcpkg.json: every library Orbit needs, pinned to Orbit's baseline.
    with open(os.path.join(project_name, "vcpkg.json"), "w") as f:
        json.dump(project_manifest(project_name), f, indent=2)
        f.write("\n")

    print(f"✅ Successfully created Orbit project: {project_name}")
    print(f"👉 Next steps:")
    print(f"   cd {project_name}")
    print(f"   orbit build")
    print(f"   orbit run")

def build_project(build_type, jobs):
    if not os.path.exists("CMakeLists.txt"):
        print("❌ Error: No CMakeLists.txt found in the current directory.")
        sys.exit(1)
        
    print(f"🔨 Building project ({build_type}, {jobs} parallel jobs)...")
    
    # Try to find vcpkg root
    vcpkg_root = os.environ.get("VCPKG_ROOT", "")
    
    cmake_cmd = ["cmake", "-B", "build", "-S", ".", f"-DCMAKE_BUILD_TYPE={build_type}"]
    
    if build_type == "Release":
        print("🚀 Release mode with interprocedural optimization (LTO).")
        cmake_cmd.append("-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON")
    elif build_type == "Debug":
        print("🐛 Debug mode: no optimization. Use `orbit build --release` for production.")
        
    if vcpkg_root:
        toolchain = os.path.join(vcpkg_root, "scripts", "buildsystems", "vcpkg.cmake")
        cmake_cmd.append(f"-DCMAKE_TOOLCHAIN_FILE={toolchain}")
    else:
        # Check if vcpkg folder exists locally
        local_toolchain = os.path.join(os.getcwd(), "vcpkg", "scripts", "buildsystems", "vcpkg.cmake")
        if os.path.exists(local_toolchain):
            cmake_cmd.append(f"-DCMAKE_TOOLCHAIN_FILE={local_toolchain}")
        else:
            print("⚠️ VCPKG_ROOT not set and local vcpkg folder not found. Building without vcpkg toolchain...")
            print("⚠️ If you are missing dependencies, please configure vcpkg.")

    run_command(cmake_cmd)
    run_command(["cmake", "--build", "build", "--parallel", str(jobs)])
    print("✅ Build completed successfully!")

def run_project():
    if not os.path.exists("build"):
        print("❌ Error: 'build' directory not found. Did you run 'orbit build'?")
        sys.exit(1)
        
    # Find the executable (heuristically look for the project name in CMakeLists.txt)
    project_name = None
    with open("CMakeLists.txt", "r") as f:
        for line in f:
            if line.strip().lower().startswith("project("):
                parts = line.strip().split('(')
                if len(parts) > 1:
                    project_name = parts[1].split()[0].replace(')', '')
                    break
                    
    if not project_name:
        print("❌ Error: Could not determine project name from CMakeLists.txt")
        sys.exit(1)
        
    exe_path = os.path.join("build", project_name)
    if not os.path.exists(exe_path):
        print(f"❌ Error: Executable '{exe_path}' not found. Build might have failed.")
        sys.exit(1)
        
    print(f"🚀 Running {project_name}...\n")
    subprocess.run([f"./{exe_path}"])

def main():
    parser = argparse.ArgumentParser(description="Orbit Framework CLI")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # Command: new
    parser_new = subparsers.add_parser("new", help="Create a new Orbit project")
    parser_new.add_argument("project_name", type=str, help="Name of the new project")
    parser_new.add_argument("--fetch", action="store_true", help="Use CMake FetchContent instead of find_package")

    # Command: build
    parser_build = subparsers.add_parser("build", help="Build the current Orbit project")
    mode = parser_build.add_mutually_exclusive_group()
    mode.add_argument("--release", action="store_true", help="Optimized release build (LTO enabled)")
    mode.add_argument("--debug", action="store_true", help="Unoptimized debug build")
    parser_build.add_argument("-j", "--jobs", type=int, default=None,
                              help="Parallel compile jobs (default: one per CPU, at most one per 2 GB of RAM)")

    # Command: run
    parser_run = subparsers.add_parser("run", help="Run the current Orbit project")

    args = parser.parse_args()

    if args.command == "new":
        create_project(args.project_name, args.fetch)
    elif args.command == "build":
        build_type = "Release" if args.release else "Debug" if args.debug else "RelWithDebInfo"
        jobs = args.jobs if args.jobs and args.jobs > 0 else default_jobs()
        build_project(build_type, jobs)
    elif args.command == "run":
        run_project()
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
