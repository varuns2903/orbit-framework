@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find all dependencies required by OrbitFramework
find_dependency(OpenSSL REQUIRED)
find_dependency(ZLIB REQUIRED)
find_dependency(PostgreSQL REQUIRED)
find_dependency(CURL REQUIRED)
find_dependency(unofficial-libmariadb CONFIG)
find_dependency(mongoc-1.0 CONFIG)
find_dependency(hiredis CONFIG)
find_dependency(nghttp2 CONFIG)
find_dependency(ngtcp2 CONFIG)
find_dependency(nghttp3 CONFIG)

# Include the generated targets file
include("${CMAKE_CURRENT_LIST_DIR}/OrbitFrameworkTargets.cmake")

check_required_components(OrbitFramework)
