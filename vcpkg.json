{
  "name": "orbit-framework",
  "version-string": "0.1.0",
  "description": "A blazing fast, asynchronous, and middleware-driven C++20 HTTP/3 web framework",
  "dependencies": [
    "openssl",
    "zlib",
    "libpq",
    "curl",
    "libmariadb",
    "mongo-c-driver",
    "nghttp2",
    "nghttp3",
    "ngtcp2",
    "hiredis"
  ],
  "features": {
    "grpc": {
      "description": "gRPC support",
      "dependencies": ["grpc"]
    }
  }
}
